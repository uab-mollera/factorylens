# FactoryLens Environment Configuration
# Copy this file to .env and update the values

# -----------------------------------------------------------------------------
# SECURITY - MUST CHANGE THESE VALUES
# Generate secure keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=changethis
FIRST_SUPERUSER_PASSWORD=changethis
POSTGRES_PASSWORD=changethis

# -----------------------------------------------------------------------------
# Project Configuration
# -----------------------------------------------------------------------------
PROJECT_NAME=FactoryLens
STACK_NAME=factorylens
DOMAIN=localhost

# Environment: local, staging, or production
ENVIRONMENT=local

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres

# -----------------------------------------------------------------------------
# First Superuser (Admin Account)
# -----------------------------------------------------------------------------
FIRST_SUPERUSER=admin@example.com

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,https://localhost,https://localhost:5173

# -----------------------------------------------------------------------------
# Email Configuration (Optional - for password recovery)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME=

# -----------------------------------------------------------------------------
# Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# KepServer Integration (Configure in Airflow UI after startup)
# These are set as Airflow Variables, not in .env
# -----------------------------------------------------------------------------
# KEP_HOST=kepserver.local
# KEP_PORT=57412
# KEP_USERNAME=admin
# KEP_PASSWORD=your-kepserver-password
# MACHINE_TAG_MAP={"machine-uuid-1": "Channel1.Device1.OEE"}
# DB_CONN_STR=postgresql+psycopg2://postgres:password@db:5432/app
